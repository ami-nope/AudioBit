<Window x:Class="AudioBit.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="{Binding ModeHeadline}"
        Width="360"
        Height="600"
        MinWidth="360"
        MinHeight="600"
        MaxWidth="360"
        MaxHeight="600"
        Background="#131722"
        FontFamily="Segoe UI"
        Foreground="#FFFFFF"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="ShellOuterBrush" Color="#2C3040" />
        <SolidColorBrush x:Key="ShellInnerBrush" Color="#373A4A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#2F3240" />
        <SolidColorBrush x:Key="CardBrush" Color="#343746" />
        <SolidColorBrush x:Key="InputBrush" Color="#373A49" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#868695" />
        <SolidColorBrush x:Key="TrackBrush" Color="#D4D4D8" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FAFAFB" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C8CAD3" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#979AA8" />
        <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FF902A" />
        <Geometry x:Key="GitHubIconGeometry">M12,0.5C5.648,0.5 0.5,5.648 0.5,12C0.5,17.084 3.792,21.389 8.365,22.91C8.94,23.014 9.15,22.66 9.15,22.354C9.15,22.08 9.139,21.169 9.135,20.204C5.935,20.899 5.258,18.661 5.258,18.661C4.735,17.333 3.981,16.98 3.981,16.98C2.938,16.267 4.06,16.282 4.06,16.282C5.214,16.363 5.821,17.468 5.821,17.468C6.847,19.227 8.513,18.719 9.17,18.425C9.274,17.682 9.571,17.174 9.899,16.886C7.345,16.596 4.661,15.609 4.661,11.203C4.661,9.948 5.11,8.922 5.845,8.118C5.726,7.828 5.332,6.658 5.957,5.073C5.957,5.073 6.923,4.764 9.124,6.251C10.086,5.983 11.069,5.85 12,5.855C12.975,5.86 13.958,5.987 14.878,6.242C17.079,4.755 18.043,5.064 18.043,5.064C18.67,6.649 18.276,7.819 18.157,8.109C18.895,8.913 19.339,9.939 19.339,11.194C19.339,15.611 16.651,16.583 14.087,16.867C14.499,17.221 14.866,17.919 14.866,18.987C14.866,20.517 14.852,21.75 14.852,22.126C14.852,22.435 15.059,22.791 15.642,22.678C20.21,21.384 23.5,17.081 23.5,12C23.5,5.648 18.352,0.5 12,0.5Z</Geometry>
        <Geometry x:Key="GlobeIconGeometry">M12,2A10,10 0 1 0 12,22A10,10 0 1 0 12,2ZM4.3,9.5H7.1C7.3,7.89 7.72,6.38 8.34,5.08C6.43,5.82 4.95,7.43 4.3,9.5ZM4.3,14.5C4.95,16.57 6.43,18.18 8.34,18.92C7.72,17.62 7.3,16.11 7.1,14.5H4.3ZM9.13,9.5H14.87C14.61,7.7 14.07,6.09 13.33,4.87C12.9,4.16 12.45,3.75 12,3.75C11.55,3.75 11.1,4.16 10.67,4.87C9.93,6.09 9.39,7.7 9.13,9.5ZM9.13,14.5C9.39,16.3 9.93,17.91 10.67,19.13C11.1,19.84 11.55,20.25 12,20.25C12.45,20.25 12.9,19.84 13.33,19.13C14.07,17.91 14.61,16.3 14.87,14.5H9.13ZM16.9,9.5H19.7C19.05,7.43 17.57,5.82 15.66,5.08C16.28,6.38 16.7,7.89 16.9,9.5ZM16.9,14.5C16.7,16.11 16.28,17.62 15.66,18.92C17.57,18.18 19.05,16.57 19.7,14.5H16.9ZM8.94,12C8.94,12.51 8.96,13.01 9,13.5H15C15.04,13.01 15.06,12.51 15.06,12C15.06,11.49 15.04,10.99 15,10.5H9C8.96,10.99 8.94,11.49 8.94,12Z</Geometry>

        <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#4D62D7" />
            <GradientStop Offset="0.14" Color="#4459CF" />
            <GradientStop Offset="0.15" Color="#F06A22" />
            <GradientStop Offset="1" Color="#D84A18" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SecondaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#9CA7E8" />
            <GradientStop Offset="0.32" Color="#6B82E1" />
            <GradientStop Offset="1" Color="#3050BE" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WhiteButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FBFBFC" />
            <GradientStop Offset="1" Color="#E8E8EC" />
        </LinearGradientBrush>

        <Style x:Key="WindowDotStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.01" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.01" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.97" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="#FFF8F6F4" />
            <Setter Property="BorderBrush" Value="#545C87" />
        </Style>

        <Style x:Key="SecondaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="#FFF7F8FC" />
            <Setter Property="BorderBrush" Value="#6B74A2" />
        </Style>

        <Style x:Key="WhitePillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource WhiteButtonBrush}" />
            <Setter Property="Foreground" Value="#1B1C21" />
            <Setter Property="BorderBrush" Value="#D8D8DD" />
        </Style>

        <Style x:Key="IconPillButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="26">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.01" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.01" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionPillCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chrome"
                                Height="52"
                                Margin="{TemplateBinding Margin}"
                                Padding="16,0,14,0"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="26">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34" VerticalAlignment="Center">
                                    <Ellipse Fill="#363847" Stroke="#888896" StrokeThickness="1" />
                                    <Ellipse x:Name="Indicator" Margin="3" Fill="{StaticResource AccentOrangeBrush}" />
                                </Grid>
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Indicator" Property="Fill" Value="#6B584E" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.006" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.006" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#131722">
        <Border Margin="12"
                Background="{StaticResource ShellOuterBrush}"
                BorderBrush="#2A2D39"
                BorderThickness="5"
                CornerRadius="34">
            <Border Margin="6"
                    Background="{StaticResource ShellInnerBrush}"
                    BorderBrush="#2B2D39"
                    BorderThickness="1"
                    CornerRadius="29">
                <Grid x:Name="ShellClipHost">
                    <Grid Margin="24,20,22,0" PreviewMouseLeftButtonDown="TopBar_OnPreviewMouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="54" Height="54" Background="#FF922C" CornerRadius="16">
                                <Image Width="34"
                                       Height="34"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="Assets/AudioBit.ico"
                                       Stretch="Uniform" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Top">
                                <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding HeaderModeText}" />
                                <TextBlock Margin="0,-7,0,0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding HeaderTitleText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,4,0,0" Orientation="Horizontal">
                            <Button Background="#62EB69" Click="MinimizeButton_Click" Style="{StaticResource WindowDotStyle}" />
                            <Button Margin="11,0,0,0" Background="#FF5C7C" Click="CloseButton_Click" Style="{StaticResource WindowDotStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="18,106,18,18"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="33">
                        <Grid>
                            <Grid Margin="16,16,16,14"
                                  Visibility="{Binding ShowLocationStep, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Margin="11,9,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="Choose an Install Folder" />

                                <Border Grid.Row="1"
                                        Margin="6,12,6,0"
                                        Padding="14,14,14,16"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="30">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="7,0,0,0"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding InstallFolderHeaderText}" />
                                        <Border Grid.Row="1"
                                                Margin="0,14,0,0"
                                                Height="43"
                                                Padding="12,0"
                                                Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource StrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="18">
                                            <TextBlock FontSize="11.6"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Text="{Binding InstallPath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding InstallPath}" />
                                        </Border>
                                        <Grid Grid.Row="2" Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Height="40"
                                                    Click="BrowsePathButton_Click"
                                                    IsEnabled="{Binding CanInstall}"
                                                    Style="{StaticResource SecondaryPillButtonStyle}">
                                                <TextBlock FontSize="13.2" FontWeight="Bold" TextAlignment="Center" Text="Change&#x0a;Folder" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Height="40"
                                                    Click="ProceedButton_Click"
                                                    Content="Next"
                                                    IsEnabled="{Binding CanProceedFromLocation}"
                                                    Style="{StaticResource PrimaryPillButtonStyle}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="2"
                                           Margin="11,23,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="Info" />

                                <Border Grid.Row="3"
                                        Margin="6,12,6,0"
                                        Padding="15,14,15,12"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="30">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="31" Height="31" Background="#FF922C" CornerRadius="9" VerticalAlignment="Top">
                                            <Image Width="19"
                                                   Height="19"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Source="Assets/AudioBit.ico"
                                                   Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Margin="9,2,0,0"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="AudioBit" />

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <Button Click="GitHubButton_Click"
                                                    Style="{StaticResource IconPillButtonStyle}"
                                                    ToolTip="{Binding GitHubLinkToolTipText}"
                                                    Width="40"
                                                    Height="40">
                                                <Viewbox Width="18" Height="18">
                                                    <Path Fill="#E7E7E8" Data="{StaticResource GitHubIconGeometry}" />
                                                </Viewbox>
                                            </Button>
                                            <Button Margin="0,8,0,0"
                                                    Click="WebsiteButton_Click"
                                                    Style="{StaticResource IconPillButtonStyle}"
                                                    ToolTip="{Binding WebsiteLinkToolTipText}"
                                                    Width="40"
                                                    Height="40">
                                                <Viewbox Width="18" Height="18">
                                                    <Path Fill="#3F7AF2" Data="{StaticResource GlobeIconGeometry}" />
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,0">
                                            <TextBlock FontSize="10.1" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding PublisherLineText}" />
                                            <TextBlock FontSize="10.1" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding VersionLineText}" />
                                            <TextBlock FontSize="10.1" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SourceLineText}" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="106" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="31,0,0,0">
                                                <TextBlock FontSize="9.8"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding RatingCountDisplayText}" />
                                                <TextBlock Margin="10,1,0,0"
                                                           FontSize="19"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Text="{Binding RatingDisplayText}" />
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="10.5"
                                                           Foreground="#9FA2AC"
                                                           Text="{Binding RatingStarsDisplayText}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock FontSize="9.8"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="LANGUAGE" />
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Text="{Binding LanguageText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Margin="16,16,16,14"
                                  Visibility="{Binding ShowOptionsStep, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Margin="6,12,6,0"
                                        Padding="14,14,14,14"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="30">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding CreateStartMenuShortcut}" Style="{StaticResource OptionPillCheckBoxStyle}">
                                            <TextBlock FontSize="16" FontWeight="Bold" TextAlignment="Center" Text="Create Start Menu&#x0a;Shortcut" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding CreateDesktopShortcut}" Style="{StaticResource OptionPillCheckBoxStyle}">
                                            <TextBlock FontSize="16" FontWeight="Bold" TextAlignment="Center" Text="Create Desktop&#x0a;Shortcut" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding PinToStart}" Style="{StaticResource OptionPillCheckBoxStyle}">
                                            <TextBlock FontSize="16" FontWeight="Bold" TextAlignment="Center" Text="Pin to Start" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding PinToTaskbar}" Style="{StaticResource OptionPillCheckBoxStyle}">
                                            <TextBlock FontSize="16" FontWeight="Bold" TextAlignment="Center" Text="Pin to Taskbar" />
                                        </CheckBox>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Width="82"
                                                    Height="50"
                                                    Click="GitHubButton_Click"
                                                    Style="{StaticResource IconPillButtonStyle}"
                                                    ToolTip="{Binding GitHubLinkToolTipText}">
                                                <Viewbox Width="22" Height="22">
                                                    <Path Fill="#E7E7E8" Data="{StaticResource GitHubIconGeometry}" />
                                                </Viewbox>
                                            </Button>

                                            <CheckBox Grid.Column="2"
                                                      Margin="0"
                                                      IsChecked="{Binding LaunchAfterInstall}"
                                                      Style="{StaticResource OptionPillCheckBoxStyle}">
                                                <TextBlock FontSize="16" FontWeight="Bold" TextAlignment="Center" Text="Launch&#x0a;Audiobit" />
                                            </CheckBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Grid.Row="1" Margin="30,18,30,0" Columns="2">
                                    <Button Margin="0,0,10,0"
                                            Click="BackButton_Click"
                                            Content="Back"
                                            IsEnabled="{Binding CanInstall}"
                                            Style="{StaticResource SecondaryPillButtonStyle}" />
                                    <Button Margin="10,0,0,0"
                                            Click="InstallButton_Click"
                                            Content="{Binding OptionsPrimaryActionText}"
                                            IsEnabled="{Binding CanRunPrimaryAction}"
                                            Style="{StaticResource PrimaryPillButtonStyle}" />
                                </UniformGrid>
                            </Grid>

                            <Grid Margin="16,16,16,14"
                                  Visibility="{Binding ShowProgressStep, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Margin="6,0,6,0"
                                        Padding="16,16,16,18"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="30">
                                    <StackPanel>
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding ProgressTitleText}" />

                                        <Grid Margin="5,21,5,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="54" Height="54" Background="#FF922C" CornerRadius="15">
                                                <Image Width="33"
                                                       Height="33"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="Assets/AudioBit.ico"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Margin="17,4,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Text="{Binding ProgressPercentText}" />
                                        </Grid>

                                        <Grid Margin="5,10,5,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="9.6"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding ProgressBarLabelText}" />
                                                <TextBlock Grid.Column="1"
                                                           FontSize="9.6"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding MainBarPercentLabelText}" />
                                            </Grid>
                                            <Border Grid.Row="1"
                                                    Margin="0,6,0,0"
                                                    Height="7"
                                                    Background="{StaticResource TrackBrush}"
                                                    CornerRadius="3.5">
                                                <Grid HorizontalAlignment="Left">
                                                    <Border x:Name="MainProgressFill"
                                                            Width="246"
                                                            Background="{StaticResource AccentOrangeBrush}"
                                                            CornerRadius="3.5"
                                                            HorizontalAlignment="Left"
                                                            RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="0" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,30,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="113" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneOneTitle}" />
                                                <Border Grid.Column="1" Margin="8,0,8,0" Height="5" VerticalAlignment="Center" Background="{StaticResource TrackBrush}" CornerRadius="2.5">
                                                    <Grid HorizontalAlignment="Left">
                                                        <Border x:Name="LaneOneFill"
                                                                Width="126"
                                                                Background="{StaticResource AccentOrangeBrush}"
                                                                CornerRadius="2.5"
                                                                HorizontalAlignment="Left"
                                                                RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="0" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneOnePercentText}" />
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="113" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneTwoTitle}" />
                                                <Border Grid.Column="1" Margin="8,0,8,0" Height="5" VerticalAlignment="Center" Background="{StaticResource TrackBrush}" CornerRadius="2.5">
                                                    <Grid HorizontalAlignment="Left">
                                                        <Border x:Name="LaneTwoFill"
                                                                Width="126"
                                                                Background="{StaticResource AccentOrangeBrush}"
                                                                CornerRadius="2.5"
                                                                HorizontalAlignment="Left"
                                                                RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="0" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneTwoPercentText}" />
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="113" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneThreeTitle}" />
                                                <Border Grid.Column="1" Margin="8,0,8,0" Height="5" VerticalAlignment="Center" Background="{StaticResource TrackBrush}" CornerRadius="2.5">
                                                    <Grid HorizontalAlignment="Left">
                                                        <Border x:Name="LaneThreeFill"
                                                                Width="126"
                                                                Background="{StaticResource AccentOrangeBrush}"
                                                                CornerRadius="2.5"
                                                                HorizontalAlignment="Left"
                                                                RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="0" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneThreePercentText}" />
                                            </Grid>

                                            <Grid Grid.Row="3" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="113" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneFourTitle}" />
                                                <Border Grid.Column="1" Margin="8,0,8,0" Height="5" VerticalAlignment="Center" Background="{StaticResource TrackBrush}" CornerRadius="2.5">
                                                    <Grid HorizontalAlignment="Left">
                                                        <Border x:Name="LaneFourFill"
                                                                Width="126"
                                                                Background="{StaticResource AccentOrangeBrush}"
                                                                CornerRadius="2.5"
                                                                HorizontalAlignment="Left"
                                                                RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="0" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneFourPercentText}" />
                                            </Grid>

                                            <Grid Grid.Row="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="113" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneFiveTitle}" />
                                                <Border Grid.Column="1" Margin="8,0,8,0" Height="5" VerticalAlignment="Center" Background="{StaticResource TrackBrush}" CornerRadius="2.5">
                                                    <Grid HorizontalAlignment="Left">
                                                        <Border x:Name="LaneFiveFill"
                                                                Width="126"
                                                                Background="{StaticResource AccentOrangeBrush}"
                                                                CornerRadius="2.5"
                                                                HorizontalAlignment="Left"
                                                                RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="0" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9.4" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProgressLaneFivePercentText}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Grid.Row="1" Margin="25,18,25,0" Columns="2">
                                    <Button Margin="0,0,10,0"
                                            Click="ProgressSecondaryButton_Click"
                                            Content="{Binding ProgressSecondaryActionText}"
                                            IsEnabled="{Binding CanUseProgressSecondaryAction}"
                                            Style="{StaticResource WhitePillButtonStyle}" />
                                    <Button Margin="10,0,0,0"
                                            Click="InstallButton_Click"
                                            Content="{Binding InstallButtonText}"
                                            IsEnabled="{Binding CanRunPrimaryAction}"
                                            Style="{StaticResource PrimaryPillButtonStyle}" />
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
